flowchart TB
  classDef source fill:#F0FDF4,stroke:#16A34A,color:#14532D,stroke-width:1.6px
  classDef build fill:#EFF6FF,stroke:#2563EB,color:#172554,stroke-width:1.6px
  classDef pg fill:#ECFEFF,stroke:#0891B2,color:#164E63,stroke-width:1.6px
  classDef graphNode fill:#FAF5FF,stroke:#7C3AED,color:#3B0764,stroke-width:1.6px
  classDef decision fill:#FFFBEB,stroke:#D97706,color:#78350F,stroke-width:1.6px
  classDef output fill:#ECFDF5,stroke:#059669,color:#064E3B,stroke-width:1.6px
