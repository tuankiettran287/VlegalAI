    qa["<b>Q&amp;A and identity</b><br/><br/><b>UI routes</b><br/>/ &nbsp; /huong-dan<br/><br/><b>FastAPI families</b><br/>/api/auth/*<br/>/api/chat &nbsp; /api/conversations/*"]
    contracts["<b>Labor-contract workspace</b><br/><br/><b>UI routes</b><br/>/tao-hop-dong &nbsp; /review-hop-dong<br/>/so-sanh-hop-dong<br/><br/><b>FastAPI family</b><br/>/api/contracts/*"]
  end

  subgraph secondary["Knowledge and operational surfaces"]
    direction LR
    knowledge["<b>Knowledge and saved work</b><br/><br/><b>UI routes</b><br/>/bai-viet &nbsp; /thu-vien &nbsp; /van-ban<br/><br/><b>FastAPI families</b><br/>/api/articles/* &nbsp; /api/artifacts/*<br/>/api/laws/*"]
