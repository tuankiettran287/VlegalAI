  subgraph contractLayer["Shared browser-to-backend contract"]
    direction LR
    client["<b>Shared TypeScript API client</b><br/>same-origin HTTPS &nbsp; - &nbsp; session cookie &nbsp; - &nbsp; typed DTOs<br/>request ID &nbsp; - &nbsp; timeout &nbsp; - &nbsp; error normalization"]
    boundary["<b>Browser trust boundary</b><br/>The frontend communicates only with FastAPI.<br/>It never connects directly to Cloud SQL, Neo4j, Secret Manager, or Vertex AI."]
    client -->|only permitted application path| boundary
  end

  primary -->|route requests| contractLayer
  secondary -->|route requests| contractLayer

