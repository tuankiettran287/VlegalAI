{
  "name": "LaborCare GraphRAG question bank",
  "version": "3.0",
  "description": "Bộ câu hỏi kiểm thử hệ thống GraphRAG pháp luật lao động, phân tầng theo độ phức tạp suy luận: single-hop → multi-hop → multi-abstract. Mọi căn cứ pháp lý đều đã đối chiếu trực tiếp với kho văn bản trong thư mục 'Data (1)'.",
  "tiers": {
    "single_hop": {
      "order": 1,
      "name": "Single-hop",
      "description": "Câu trả lời nằm gọn trong MỘT điều/khoản. Chỉ cần một bước truy hồi.",
      "levels": {
        "1": "Tra cứu định nghĩa, khái niệm",
        "2": "Tra cứu con số, tỷ lệ, mốc thời gian"
      }
    },
    "multi_hop": {
      "order": 2,
      "name": "Multi-hop",
      "description": "Phải nối từ 2 nút trở lên: nhiều điều trong một văn bản, hoặc luật gốc ↔ nghị định hướng dẫn ↔ nghị định xử phạt.",
      "levels": {
        "3": "Nhiều điều trong cùng một văn bản",
        "4": "Liên văn bản (2 hop)",
        "5": "Chuỗi 3 hop trở lên"
      }
    },
    "multi_abstract": {
      "order": 3,
      "name": "Multi-abstract",
      "description": "Không đoạn văn bản đơn lẻ nào chứa câu trả lời. Hệ thống phải tổng hợp, so sánh hoặc trừu tượng hoá trên nhiều nguồn.",
      "levels": {
        "6": "So sánh, đối chiếu nhiều chế định",
        "7": "Tư vấn tình huống: tính toán + áp dụng + cảnh báo rủi ro",
        "8": "Tổng hợp toàn cục ở cấp bộ văn bản"
      }
    }
  },
  "scoring": {
    "expect_any": "Ít nhất một căn cứ phải xuất hiện trong top-k nguồn.",
    "expect_all": "Toàn bộ căn cứ phải xuất hiện trong top-k (đo recall trích dẫn).",
    "expect_min": "Phải đạt tối thiểu N căn cứ trong danh sách (dùng cho multi-abstract).",
    "expect_text": "Các dữ kiện bắt buộc phải có trong văn bản nguồn trả về.",
    "answer_must_contain": "Các dữ kiện bắt buộc phải xuất hiện trong CÂU TRẢ LỜI cuối cùng của LLM."
  },
