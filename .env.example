# Application
APP_ENV=development
PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
LOG_LEVEL=INFO

# Externally managed PostgreSQL/Cloud SQL. When developing locally, point this
# URL at a Cloud SQL Auth Proxy listener (for example, 127.0.0.1:5433).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5433/DATABASE
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30

# Google Account login (Gmail and Google Workspace) using OAuth 2.0 / OIDC.
# Create a Web application OAuth client in Google Cloud Console and register
# OIDC_REDIRECT_URI as an Authorized redirect URI.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
GUEST_CHAT_REQUESTS_PER_MINUTE=4
GUEST_CHAT_REQUESTS_PER_HOUR=30
CONVERSATION_SUMMARY_BATCH_SIZE=12
CONVERSATION_SUMMARY_MAX_TOKENS=900
SEMANTIC_ANSWER_CACHE_ENABLED=true
SEMANTIC_ANSWER_CACHE_SIMILARITY=0.96
SEMANTIC_ANSWER_CACHE_TTL_HOURS=24
SEMANTIC_ANSWER_CACHE_MAX_QUERY_CHARS=1500
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
OIDC_CLIENT_SECRET=your-google-web-client-secret
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
OIDC_SCOPES=openid email profile
OIDC_ADMIN_GROUPS=vlegal-admins
OIDC_REVIEWER_GROUPS=vlegal-reviewers

# 32 random bytes encoded with URL-safe base64. Keep the production value in
# Secret Manager or another external secret store in production.
MESSAGE_ENCRYPTION_KEY=

# Server-only policy; intentionally hidden from the frontend.
RETRIEVER_BACKEND=hybrid_rag
RETRIEVAL_TOP_K=10
# Dedicated bounded sync pool used by the parallel pgvector/BM25 branches.
RETRIEVAL_POSTGRES_POOL_SIZE=3
LEGAL_FRESHNESS_TTL_HOURS=24
LEGAL_VERIFICATION_CONCURRENCY=4
FRESHNESS_LOCK_WAIT_SECONDS=120
REQUIRE_FRESHNESS_CHECK=true
# Fail closed for legal answers unless both Tavily and Google Search grounding
# were successfully consulted.
LEGAL_SEARCH_REQUIRE_BOTH=true
LEGAL_VERDICT_MIN_CONFIDENCE=0.75
MAX_LAWS_VERIFIED_PER_REQUEST=16
GOOGLE_SEARCH_MAX_RESULTS=10

# Gemini text generation through Vertex AI. env.json is an untracked Google
# service-account credential; set GEMINI_CREDENTIALS_PATH only when it is
# mounted elsewhere.
#
# GEMINI_USE_ADC must stay true whenever authentication goes through a service
# account or Cloud Run service identity: the bearer token is only attached to the
# Vertex request when this flag is set, so leaving it false makes every call fail
# with HTTP 401 even though the credential loaded fine. Set it to false only when
# authenticating with GEMINI_API_KEY instead.
GEMINI_CREDENTIALS_PATH=env.json
GEMINI_USE_ADC=true
GEMINI_PROJECT_ID=
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=3
GEMINI_MAX_CONCURRENT_GENERATIONS=8
GEMINI_GOOGLE_SEARCH_MAX_OUTPUT_TOKENS=16384
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_LEVEL=low
GEMINI_DATA_POLICY=redact

# Semantic embeddings. Use "vertex" with ADC or "gemini-api" with
# GEMINI_API_KEY. Output remains 1024-dimensional for the current pgvector
# schema. Document batches reduce indexing request count on both providers.
EMBEDDING_PROVIDER=vertex
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_LOCATION=asia-southeast1
EMBEDDING_MAX_CONCURRENCY=8
EMBEDDING_BATCH_SIZE=20
# Vertex counts this as HTTP requests/minute; Gemini API counts embedded
# contents/minute. A Vertex batch therefore consumes one unit.
EMBEDDING_MAX_ITEMS_PER_MINUTE=0
# Optional Vertex endpoint pool. Each region receives its own request budget;
# leave both values empty/zero for a single EMBEDDING_LOCATION endpoint.
EMBEDDING_VERTEX_LOCATIONS=
EMBEDDING_VERTEX_REQUESTS_PER_MINUTE=0
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=3
EMBEDDING_AUTO_TRUNCATE=true

# Called before every legal result to verify cited laws are still current
TAVILY_API_KEY=your-tavily-api-key
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TIMEOUT_SECONDS=30
OFFICIAL_LEGAL_DOMAINS=vanban.chinhphu.vn,vbpl.vn,quochoi.vn,congbao.chinhphu.vn,moj.gov.vn

# Neo4j graph store and PostgreSQL pgvector store
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-neo4j-password
NEO4J_DATABASE=neo4j
POSTGRES_VECTOR_SIZE=1024

# Corpus and local GraphRAG index paths. Only the index builder reads these:
# scripts/build_graphrag.py, scripts/sync_external_graphrag.py (the reindex
# image) and scripts/run_question_bank.py. The API and the Celery worker serve
# every request from PostgreSQL/pgvector and Neo4j, so they never touch them.
LEGAL_DATA_DIR=Data (1)
LEGAL_STORAGE_DIR=storage/graphrag
LEGAL_GRAPHRAG_DB=storage/graphrag/legal_graphrag.sqlite

# Background workers use PostgreSQL through DATABASE_URL.
